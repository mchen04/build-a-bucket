export type Revision = { stage: string; progress: string };
export type Seat = { seat: number; name: string };
export type Read = { seat: Seat; revision: unknown; tables: string[][] };
export type CompareResult = {
  ok: boolean;
  reason?: string;
  revision?: Revision;
  seats?: string[];
  standings?: string[][];
  rowsCompared?: number;
};
export type Coverage = { ok: boolean; reason: string | null };
export type ReloadProof = {
  classification: 'stable-match' | 'unequal' | 'no-held-boundary' | 'invalid-display' | 'recap-before-proof' | 'no-common-revision';
  reason?: string | null;
  revision: Revision | null;
  seats: string[];
  rowsCompared: number;
  standings: string[][] | null;
  attempts: unknown[];
};
export type ReloadRecord = {
  ran?: boolean;
  revision?: unknown;
  seats?: unknown;
  rowsCompared?: number;
  refreshedSeat?: unknown;
  coverage?: string;
  [key: string]: unknown;
};
export type RecapSeat = { seat: number; name: string; you: boolean; finish: string; record: string };
export type RecapFinal = { name: string; record: string; team: string; finish: string };
export type RecapCapture = { seats: RecapSeat[]; recap: RecapFinal[]; champion: string; activity: string };
export type RecapElimination = { allEliminated: boolean; reason: string | null; record: { source: 'recap'; champion: string; seats: { seat: number; name: string; finish: string; record: string }[]; playoffSample: unknown } | null };
export type FailureSummary = {
  ok: boolean;
  error: string;
  reload: ReloadRecord;
  failedAt: string;
  [key: string]: unknown;
};

export function isValidRevision(revision: unknown): boolean;
export function revisionKey(revision: unknown): string | null;
export function revisionLabel(revision: unknown): string;
export function readLeagueStandings(): { revision: Revision; tables: string[][] };
export function seatIdentities(seats: unknown): Map<number, Set<string>>;
export function distinctSeatLabels(seats: unknown): Set<string>;
export function canonicalTables(tables: unknown): string[][];
export function allEliminated(args: { out: unknown; activity: unknown }): boolean;
export function parseRecapCapture(aria: string): RecapCapture | null;
export function recapElimination(args: { players: number; captures: { seat: number; aria: string }[]; playoffSample?: { out: boolean[]; autoStart: boolean[] } | null; gateSeen?: boolean }): RecapElimination;
export function newReloadState(): ReloadRecord;
export function shouldAwaitStandings(args: { navigation?: { observed?: boolean } | null; session?: { present?: boolean } | null }): boolean;
export function awaitReloadProof(args: {
  readAll: () => Promise<Read[]>;
  isRecap: () => Promise<boolean>;
  refreshedSeat: Seat;
  wait: () => Promise<void>;
  attempts?: number;
  gate?: boolean;
  navigation?: { observed?: boolean; reason?: string } | null;
  session?: { present?: boolean } | null;
}): Promise<ReloadProof>;
export function compareStandings(reads: Read[], refreshedSeat: Seat): CompareResult;
export function createLeagueEvidenceDir(evidenceRoot: string, stamp?: string, suffix?: string): string;
export function refreshCoverage(reloadRequested: boolean, reload: unknown): Coverage;
export function reloadRecord(reloadRequested: boolean, reload: unknown): ReloadRecord;
export function leagueFailureSummary(args: Record<string, unknown>): FailureSummary;
export function assertRefreshCoverage(reloadRequested: boolean, reload: unknown): void;
